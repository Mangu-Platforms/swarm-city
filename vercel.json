{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "SUPABASE_URL": "@swarm-city-supabase-url",
    "SUPABASE_ANON_KEY": "@swarm-city-supabase-anon-key"
  }
}
