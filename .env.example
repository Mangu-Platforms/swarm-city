# Select light, balanced, or quality. The installer writes your choice.
AGENTS_PROFILE=balanced

# Optional model overrides. Leave blank to use the selected profile defaults.
SWARM_CODER_MODEL=
SWARM_REASONER_MODEL=
SWARM_REVIEW_MODEL=
SWARM_SECURITY_MODEL=
SWARM_DRAFT_AGENTS=
SWARM_REASONER_DRAFT_AGENTS=
SWARM_QUALITY_REVIEWERS=
SWARM_SECURITY_REVIEWERS=
SWARM_TEST_AGENTS=

# Optional DeepSeek V4 synthesis. Leave the key blank for a fully local swarm.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_MONTHLY_TOKEN_BUDGET=20000000
SKIP_FINALIZE=false
FINALIZER_FALLBACK_LOCAL=true

# Swarm sizing. Start conservative and increase only after observing memory.
N_DRAFT=4
M_CRITICS=2
TOP_K=2
MAX_CONCURRENT_AGENT_CALLS=4
MAX_ACTIVE_TASKS=1
MAX_QUEUED_TASKS=20
AGENT_TIMEOUT_S=300
TASK_TIMEOUT_S=1800
LOCAL_MAX_TOKENS=8192
LOCAL_CONTEXT_TOKENS=65536

# Release gates.
MINIMUM_CANDIDATE_SCORE=6.5
MINIMUM_CRITIC_REVIEWS=2
MINIMUM_SECURITY_REVIEWS=1
REQUIRE_SECURITY_REVIEW=true
FINAL_REVIEW_COUNT=2
MAX_REPAIR_ROUNDS=1
REQUIRE_HIGH_RISK_APPROVAL=true

# Repository-aware context.
TARGET_REPO=./
REPO_MOUNT_MODE=ro
AUTO_CONTEXT=true
AUTO_CONTEXT_FILES=8
MAX_CONTEXT_FILES=16
MAX_CONTEXT_FILE_CHARS=20000
MAX_CONTEXT_CHARS=80000
REDACT_SECRETS=true

# Git integration is disabled by default. Generated repository code must not run
# unless TEST_RUNNER_COMMAND points to an operator-controlled external sandbox.
ENABLE_GIT_APPLY=false
OPEN_PR=false
PR_DRAFT=true
REQUIRE_TESTS=true
TEST_COMMAND=
TEST_RUNNER_COMMAND=
ALLOW_UNSANDBOXED_TESTS=false

# Authentication. install.sh fills both secrets with random values.
REQUIRE_API_TOKEN=true
SWARM_API_TOKEN=
PROTECT_METRICS=false
MAX_REQUEST_BODY_BYTES=2000000
READINESS_REQUIRE_ALL_MODELS=true

# Service versions verified during this revamp; override only intentionally.
PYTHON_IMAGE=python:3.11.15-slim-bookworm
OLLAMA_IMAGE=ollama/ollama:0.32.0
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=
LOG_LEVEL=INFO
